# Metadados da API
APP_NAME="Pipeline Jurídico NLP"
APP_VERSION=0.1.0

# Servidor (usado por `python main.py`)
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Chunking — em caracteres, com cortes em fim de frase.
# Valores padrão, sobrescrevíveis por requisição
CHUNK_SIZE=3000
CHUNK_OVERLAP=600

# Anonimização (LGPD / Resolução CNJ nº 615/2025)
# Idioma usado no AnalyzerEngine do Presidio (correção do bug: deve ser "pt", não "en")
PRESIDIO_LANGUAGE=pt
# Modelo spaCy a ser baixado com: python -m spacy download pt_core_news_lg
SPACY_MODEL=pt_core_news_lg

# Síntese
# "mock" devolve um texto fixo (sem LLM); "ramalama" usa o LLM local abaixo (map-reduce)
SUMMARIZER_BACKEND=mock
# Servidor (porta padrão 8080): ramalama serve --ctx-size 16384 hf://bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
RAMALAMA_URL=http://localhost:8080
# Só o nome enviado nas requisições (o llama.cpp o ignora). O modelo realmente servido é lido
# do servidor e gravado em results/raw.jsonl (modelo, arquivo GGUF/quantização, build, n_ctx)
RAMALAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_SEED=42
# Máximo de tokens gerados por chamada (max_tokens). Com 512, extrações do map saíam cortadas
# (finish_reason=length); a segunda rodada do experimento usa 1024 em todas as configurações
LLM_NUM_PREDICT=1024
# O contexto é definido no servidor (--ctx-size); este valor deve ser o mesmo
LLM_NUM_CTX=16384
LLM_TIMEOUT_S=600
